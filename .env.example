# --- Supabase (donnees) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://hotgyaal.com
NEXT_PUBLIC_ORDER_CHAT_NUMBER=221774931474
NEXT_PUBLIC_ADMIN_ACCESS_CODE=142022

# --- Cloudflare R2 (images) ---
# Sans ces variables, les images repartent vers le stockage Supabase.
# Elles restent cote serveur : ne jamais les prefixer par NEXT_PUBLIC.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=hotgyaal-images
R2_PUBLIC_BASE_URL=https://img.hotgyaal.com
